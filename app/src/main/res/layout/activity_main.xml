<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF6F0D7"
    tools:context=".MainActivity">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="100dp"
        android:background="#9CAB84"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_open"
            android:padding="24dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu_burger"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="PH Regional"
            android:textColor="#4E5B2E"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Placeholder for symmetry -->
        <View
            android:layout_width="80dp"
            android:layout_height="80dp" />

    </LinearLayout>

    <!-- LANGUAGE ROW -->
    <LinearLayout
        android:id="@+id/languageRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="140dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#DCE8C9">

            <Spinner
                android:id="@+id/spinnerSource"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:entries="@array/languages_array"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </androidx.cardview.widget.CardView>

        <ImageView
            android:id="@+id/btnSwitch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_switch" />

        <androidx.cardview.widget.CardView
            android:layout_width="140dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#DCE8C9">

            <Spinner
                android:id="@+id/spinnerTarget"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:entries="@array/languages_array"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- INPUT -->
    <RelativeLayout
        android:id="@+id/inputContainer"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/box_background"
        app:layout_constraintTop_toBottomOf="@id/languageRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/suggestionText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:gravity="top"
            android:padding="20dp"
            android:textColor="#A5A5A5"
            android:textSize="18sp"
            android:visibility="visible" />

        <EditText
            android:id="@+id/inputText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:gravity="top"
            android:hint="Enter Text"
            android:padding="20dp"
            android:textColor="#4E5B2E"
            android:textColorHint="#9CAB84"
            android:textSize="18sp"
            android:inputType="textNoSuggestions"
            android:imeOptions="actionDone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_margin="8dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnClearInput"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:visibility="gone"
                app:tint="#9CAB84" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnSpeakInput"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_circle_outline"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_speak"
                android:contentDescription="Speak input"
                app:tint="#4E612C" />

            <ImageButton
                android:id="@+id/btnCopyInput"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_outline"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_copy"
                app:tint="#4E612C" />

        </LinearLayout>

    </RelativeLayout>

    <!-- OUTPUT -->
    <RelativeLayout
        android:id="@+id/outputContainer"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/box_background"
        app:layout_constraintTop_toBottomOf="@id/inputContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/outputText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp"
            android:text="Translated text here..."
            android:textColor="#4E5B2E"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnSpeak"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_circle_outline"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_speak"
                app:tint="#4E612C" />

            <ImageButton
                android:id="@+id/btnCopy"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_outline"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_copy"
                app:tint="#4E612C" />

        </LinearLayout>

    </RelativeLayout>

    <!-- ACTION BUTTONS -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="50dp"
        app:layout_constraintTop_toBottomOf="@id/outputContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnScan"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginEnd="40dp"
            android:background="@drawable/bg_green_circle"
            android:src="@drawable/ic_scan"
            android:padding="20dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/scan_text" />

        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_green_circle"
            android:src="@drawable/ic_mic"
            android:padding="20dp"
            android:scaleType="fitCenter"
            android:contentDescription="Listen" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>